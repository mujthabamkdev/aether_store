# Aether Engine Environment Variables
# DO NOT COMMIT THIS FILE WITH REAL KEYS TO VERSION CONTROL
# Generate per deployment:
#   openssl rand -hex 32    # for AETHER_API_KEY
#
# Required (engine refuses to start if missing):
AETHER_API_KEY=replace_with_openssl_rand_hex_32

# Optional — AgentRouter (GLM 5.3) provider key for the chat feature
# (chat degrades to a local fallback message if not set):
# AGENTROUTER_API_KEY=sk-your-agentrouter-key

# Optional — OpenCode Go provider key for the chat feature.
# Get it from OpenCode Zen (subscribe to Go) and paste below.
# NOTE: Muse Spark models are served ONLY on the Responses API, never on
# /v1/chat/completions (that path returns HTTP 500 for Muse).
# OPENCODE_GO_API_KEY=sk-your-opencode-go-key
# Model (default: muse-spark-1.3-contributor):
# OPENCODE_GO_MODEL=muse-spark-1.3-contributor
# Override only for debugging / self-hosted gateways:
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1/responses

# Optional — engine bind address (default 127.0.0.1 for safety)
# AETHER_BIND=0.0.0.0
# AETHER_PORT=3000
